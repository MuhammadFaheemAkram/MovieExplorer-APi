# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# Format of a SQLAlchemy database URL:
#     postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
#     "postgresql" = database type, "psycopg" = the Python driver to use (psycopg 3)

APP_NAME="Movie Explorer API"
DEBUG=true

# Main database used when the API runs.
DATABASE_URL=postgresql+psycopg://movie_api_user:change-me@localhost:5432/movie_explorer_db

# Separate database used only by the automated tests (it gets wiped by the tests!).
TEST_DATABASE_URL=postgresql+psycopg://movie_api_user:change-me@localhost:5432/movie_explorer_test_db

# Connection pool: pool_size + max_overflow must be >= FastAPI's 40 worker
# threads, or a burst of requests can deadlock (see app/core/database.py).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
